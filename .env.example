# Development values. Production requires DJANGO_DEBUG=False and DJANGO_USE_SQLITE=False.
# Set a random DJANGO_SECRET_KEY and explicit production hostnames and HTTPS origins.
DJANGO_DEBUG=True
DJANGO_USE_SQLITE=True
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_COOKIE_SAMESITE=Lax

# Required for Compose. For host-based PostgreSQL also set DJANGO_USE_SQLITE=False.
POSTGRES_DB=voyavisa
POSTGRES_USER=voyavisa
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Set locally before using the card payment workflow.
APPOINTMENT_PAYMENT_CARD=

# SMS.ir Verify template with the CODE parameter. Both values are required in production.
SMSIR_API_KEY=
SMSIR_OTP_TEMPLATE_ID=
